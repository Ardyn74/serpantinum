[Desktop Entry]
Version=1.0
Type=Application
Name=MATLAB R2026a
GenericName=MATLAB
Comment=Matrix laboratory - programming and numeric computing platform
Exec=matlab-launcher %F
Icon=matlab
Terminal=false
Categories=Development;Education;Science;Mathematics;IDE;
MimeType=text/x-matlab;application/x-matlab-data;
StartupNotify=true
StartupWMClass=MATLAB
Actions=NoSplashScreen;

[Desktop Action NoSplashScreen]
Name=Open without splash screen
Exec=matlab-launcher -nosplash %F
