layout {
    gaps 4
    center-focused-column "always"
    always-center-single-column
    default-column-width { proportion 0.75; }
    border {
        off
    }
    focus-ring {
        off
    }
}

window-rule {
    match app-id=r#"^kitty$"#
    match app-id=r#"^ski"#
    geometry-corner-radius 10
    clip-to-geometry true
}


